<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.net.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<!--
    Ecrã: Escolher Cor
    Função: O jogador escolhido pela roleta seleciona a cor (clara ou escura).
    Controlador: gui.escolhercor.EscolherCorController
-->
<BorderPane id="escolherCor" prefWidth="900" prefHeight="600" styleClass="mainFxmlClass" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.EscolherCorController">
    <stylesheets>
        <URL value="@interface.css"/>
    </stylesheets>
    
    <!-- Título -->
    <top>
        <Label fx:id="labelTitulo"
               text="Escolhe a tua cor"
               BorderPane.alignment="CENTER"
               styleClass="title-label"/>
    </top>

    <!-- Conteúdo principal -->
    <center>
        <VBox alignment="CENTER" spacing="40">

            <!-- Texto informativo -->
            <Label fx:id="labelJogadorAtual"
                   text="Jogador X, escolhe a cor:"
                   styleClass="escolhercor-label-jogador"/>

            <!-- Círculos das cores -->
            <HBox alignment="CENTER" spacing="120">

                <!-- Cor clara -->
                <Circle fx:id="circuloClara"
                        radius="50"
                        fill="white"
                        stroke="black"
                        strokeWidth="2"
                        styleClass="escolhercor-circulo-claro"
                        onMouseClicked="#selecionarClara"/>

                <!-- Cor escura -->
                <Circle fx:id="circuloEscura"
                        radius="50"
                        fill="black"
                        stroke="black"
                        strokeWidth="2"
                        styleClass="escolhercor-circulo-escuro"
                        onMouseClicked="#selecionarEscura"/>

            </HBox>

        </VBox>
    </center>

    <!-- Botão confirmar -->
    <bottom>
        <VBox alignment="CENTER" spacing="15" style="-fx-padding: 20 0 20 0;">
            <Button fx:id="btnConfirmarCor"
                    text="Confirmar"
                    prefWidth="200"
                    disable="true"
                    styleClass="escolhercor-botao"
                    onAction="#confirmarCor"/>
        </VBox>
    </bottom>

</BorderPane>

