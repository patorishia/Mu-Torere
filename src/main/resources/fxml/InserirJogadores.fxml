<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Ecrã: Inserir Jogadores
    Função: Permite ao utilizador introduzir os nomes dos dois jogadores
    Controlador associado: gui.inserir.InserirJogadoresController
-->

<BorderPane id="inserirJogadores" prefHeight="600" prefWidth="900" styleClass="mainFxmlClass" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="gui.InserirJogadoresController">
    <!-- Folha de estilos -->
    <stylesheets>
        <URL value="@interface.css" />
    </stylesheets>
    
    <!-- Título do ecrã -->
    <top>
        <Label styleClass="title-label" text="Inserir Jogadores" BorderPane.alignment="CENTER" />
    </top>
        
    <!-- Área central com os campos de texto e botão -->
    <center>
        <VBox alignment="CENTER" fillWidth="false" spacing="15">
            <!-- Nome do Jogador 1 -->
            <Label text="Jogador 1:" />
            <TextField fx:id="txtJogador1" prefHeight="31.0" prefWidth="489.0" />

            <!-- Nome do Jogador 2 -->
            <Label text="Jogador 2:" />
            <TextField fx:id="txtJogador2" prefHeight="31.0" prefWidth="490.0" />

            <!-- Botão para avançar para a roleta -->
            <Button fx:id="btnContinuarInserir" onAction="#abrirRoleta" prefWidth="200" text="Continuar" />
            <!-- Botão para voltar ao Menu IniciL -->
            <Button onAction="#voltar" prefHeight="40.0" prefWidth="200.0" text="Voltar" />

        </VBox>
    </center>

</BorderPane>
