<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    Ecrã inicial do jogo Mu Torere.
    Utiliza um BorderPane para estruturar o layout:
      - top: título
      - center: botões do menu
    O ficheiro CSS interface.css é aplicado diretamente através do atributo stylesheets.
-->
<BorderPane id="menuInicial" prefHeight="600" prefWidth="900" stylesheets="@interface.css" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.MenuInicialController">
    <!-- Título do jogo, centrado na parte superior -->
    <top>
        <Label styleClass="title-label" text="Mu Torere" BorderPane.alignment="CENTER" />
    </top>
    
    <!-- Zona central com os botões principais do menu -->
    <center>
        <VBox alignment="CENTER" spacing="20">  
            <!-- Botão para iniciar jogo local -->
            <Button fx:id="btnJogoLocal" onAction="#abrirInserirJogadores" prefWidth="200" text="Jogo Local" />
            <!-- Botão para iniciar jogo em rede -->
            <Button fx:id="btnJogoRede" onAction="#abrirJogoRede" prefWidth="200" text="Jogo em Rede" />
            <!-- Botão para abrir definições -->
            <Button fx:id="btnDefinicoes" onAction="#abrirDefinicoes" prefWidth="200" text="Definições" />
            <!-- Botão para sair da aplicação -->
            <Button fx:id="btnSair" onAction="#sairJogo" prefWidth="200" text="Sair" />
        </VBox>
    </center>

</BorderPane>
